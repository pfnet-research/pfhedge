    "\n",
    "# 获取数据\n",
    "df = ak.stock_zh_index_daily(symbol=\"sh000016\")\n",
    "\n",
    "# 保存为CSV\n",
    "df.to_csv(\"SSE50_Historical_Data.csv\", index=False)\n",
    "print(\"数据已保存至 SSE50_Historical_Data.csv\")"
   ]
  }
